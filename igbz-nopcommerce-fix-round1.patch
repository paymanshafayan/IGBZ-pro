+
+                var lengthByte = data[cursor];
+
+                if (lengthByte == 0)
+                {
+                    if (!jumped)
+                        offset = cursor + 1;
+                    break;
+                }
+
+                if ((lengthByte & 0xC0) == 0xC0)
