<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>IGBZ.Infrastructure.Tests</RootNamespace>
    <AssemblyName>IGBZ.Infrastructure.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftTestSdkVersion)" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
    <!-- MongoDB در-حافظه برای تست‌های واقعی جداسازی تننت -->
    <PackageReference Include="Mongo2Go" Version="3.1.3" />
    <!-- ServiceCollection/ServiceProvider برای ساخت DI در تست -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\IGBZ.Infrastructure\IGBZ.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\IGBZ.Domain\IGBZ.Domain.csproj" />
    <ProjectReference Include="..\..\src\IGBZ.Application\IGBZ.Application.csproj" />
  </ItemGroup>
</Project>
