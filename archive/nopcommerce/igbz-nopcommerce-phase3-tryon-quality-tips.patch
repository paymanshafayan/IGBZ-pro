 .../Services/LaunchChecklistService.cs          |  2 +-
 .../Services/VirtualTryOnService.cs             | 11 +++++++++++
 3 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/Plugins/Nop.Plugin.Misc.MultiTenantStores/Controllers/Public/VirtualTryOnController.cs b/Plugins/Nop.Plugin.Misc.MultiTenantStores/Controllers/Public/VirtualTryOnController.cs
