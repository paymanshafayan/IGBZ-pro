+        /// ⚠️ برای بهترین کیفیت: عکس کاملاً واضح، بدون خطای دید و ترجیحاً تخت (Flat-lay).
+        /// </summary>
         public string GarmentImageUrl { get; set; }
 
         /// <summary>توضیح لباس (اختیاری — برای بهبود کیفیت مدل).</summary>
