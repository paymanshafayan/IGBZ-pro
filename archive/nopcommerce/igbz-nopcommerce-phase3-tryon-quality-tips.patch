+        /// ⚠️ برای بهترین کیفیت: پس‌زمینهٔ ساده/تکرنگ + ایستادن صاف با دست‌های کمی باز (نه گره‌خورده جلوی بدن).
+        /// </summary>
         public string PersonImageUrl { get; set; }
 
-        /// <summary>URL عکس محصول (لباس).</summary>
+        /// <summary>
